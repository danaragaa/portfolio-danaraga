# Resend API key from your Resend dashboard
RESEND_API_KEY=

# Destination inbox for contact form messages
CONTACT_TO_EMAIL=

# Sender identity (must be verified for production domain)
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Optional but recommended: used for contact API origin validation
SITE_URL=https://yourdomain.com

# Optional but recommended in production (distributed anti-spam storage)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Google Analytics 4 Measurement ID (example: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: Plausible setup
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional override (default uses plausible hosted script)
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js
